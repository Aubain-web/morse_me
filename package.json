  "files": [
    "cli.mjs",
    "dist",
    "!dist/tests",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jiti": "^2.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.15.0"
  }
}
