{
  "name": "@aubain-nicolas/morse-me",
  "version": "1.1.1",
  "type": "module",
  "main": "dist/index.js",
  "license": "ISC",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "bin": {
    "morse_it": "cli.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
