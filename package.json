{
  "name": "@aubain-nicolas/morse-me",
  "version": "2.0.0",
  "description": "Encode text to Morse code, decode it back, and play it as audio — as a CLI or a library.",
  "keywords": [
    "morse",
    "morse-code",
    "cli",
    "encode",
    "decode",
    "wav",
    "audio"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aubain-web/morse_me.git"
  },
  "homepage": "https://github.com/Aubain-web/morse_me#readme",
  "bugs": {
    "url": "https://github.com/Aubain-web/morse_me/issues"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "bin": {
    "morse_it": "cli.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node cli.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node scripts/run-tests.mjs"
  },
  "files": [
    "cli.mjs",
    "dist",
    "LICENSE",
    "!dist/tests",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jiti": "^2.4.0",
    "prettier": "^3.4.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.15.0"
  }
}
